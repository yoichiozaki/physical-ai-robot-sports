{
  "run_name": "ppo_direct",
  "seed": 0,
  "total_timesteps": 48000,
  "n_envs": 16,
  "torch_threads": 1,
  "device": "cpu",
  "checkpoint_freq": 16000,
  "ppo": {
    "n_steps": 128,
    "batch_size": 256,
    "n_epochs": 10,
    "learning_rate": 0.0003,
    "gamma": 0.97,
    "gae_lambda": 0.95,
    "ent_coef": 0.0,
    "clip_range": 0.2,
    "policy_kwargs": {
      "net_arch": [
        64,
        64
      ],
      "log_std_init": -0.5
    }
  },
  "env": {
    "mode": "direct",
    "opponents": [
      "steady",
      "random",
      "aggressive",
      "lob",
      "slow"
    ],
    "conditions": [
      "nominal",
      "randomized"
    ],
    "points_per_episode": 4,
    "in_bonus": 0.1,
    "max_decisions": 80,
    "adaptive": true,
    "residual": "checkpoints/residual/model.pt"
  },
  "eval": {
    "freq": 8000,
    "episodes": 16,
    "seed": 100000
  }
}